"""
Snakefile — pipeline VGAE HUVEC sénescence (fonctionnel).

Câblé sur les CLI RÉELLES des scripts (plus de stub `python -m
gnn_huvec.cli…`). Chemins et paramètres pilotés par config/config.yaml.

Stages orchestrés :
  0   — build_features   (optionnel)       (scripts/run_v6_build.sh : prep+coexpr+HuMess)
  6   — train_vgae       × seed            (src/gnn/gnn_vgae.py)
  7   — perturb          × seed            (src/perturbation/perturb_top_genes.py)
  8   — aggregate        cross-seed        (src/validation/reports/perturb_report.py)
  8b  — driver_baselines + interpret_embedding [+ decoy opt-in]
  9   — ora_consensus (reactome + aging) [+ cluster_annotation]
  11  — report (concat des sorties clés)

Prérequis EXTERNES (non orchestrés — restent précalculés en entrée) :
  1-2 preprocessing scRNA + DE (MAST)   → data/gnn_data/
  3   pySCENIC (regulons/adjacencies)   → paths.scenic_dir
  4   HuMess (importance métabolique)   → paths.humess_dir
  + bases STRING/Reactome/OmniPath      → paths.data_root

gnn_vgae.py code en dur les chemins GLiCID par défaut ; on les surcharge
par variables d'environnement GNN_DATA_DIR / GNN_OUT_DIR_BASE /
GNN_HUMESS_DIR / GNN_SCENIC_DIR (cf. rule train_vgae).

Lancement :
    snakemake -n --configfile workflow/config/config.yaml            # dry-run
    snakemake --use-conda --cores 8 --configfile workflow/config/config.yaml
    snakemake --executor slurm -j 20 --configfile workflow/config/config.yaml  # cluster
"""

import os
import shutil
import subprocess
import sys
from pathlib import Path

configfile: "config/config.yaml"

# ──────────────────────────────────────────────────────────────────
# Résolution config
# ──────────────────────────────────────────────────────────────────
P = config["paths"]
DATA_ROOT  = Path(P["data_root"]).resolve()
# OUT_BASE : l'env GNN_OUT_DIR_BASE (ex. scratch) PRIME sur paths.out_base du config
# (le Snakefile réinjecte ensuite cette valeur dans GNN_ENV → cohérent). Sinon config.
OUT_BASE   = Path(os.environ.get("GNN_OUT_DIR_BASE") or P["out_base"]).resolve()
HUMESS_DIR = Path(P["humess_dir"]).resolve()
SCENIC_DIR = Path(P["scenic_dir"]).resolve()
DE_CSV     = P["de_magnitude_csv"]
COEXPR     = P["coexpr_file"]

DEVICE   = config["compute"]["device"]

# ──────────────────────────────────────────────────────────────────
# Localisation des scripts — indépendante du répertoire de travail
# ──────────────────────────────────────────────────────────────────
# Historiquement les règles écrivaient `python src/gnn/gnn_vgae.py`, un chemin
# relatif au CWD : le pipeline n'était donc lançable QUE depuis la racine d'un
# clone. `SRC` est désormais un chemin absolu, ce qui autorise les trois cas :
# clone, paquet installé (les scripts vivent dans site-packages), et workflow
# recopié sur un scratch de cluster (STATESHIFT_SRC).
_SRC_ENV = os.environ.get("STATESHIFT_SRC")
if _SRC_ENV:
    SRC = str(Path(_SRC_ENV).resolve())
else:
    try:
        import stateshift as _stateshift
        SRC = str(_stateshift.package_dir())
    except Exception:
        # Repli : snakemake tourne dans un AUTRE environnement que le paquet
        # (cas courant — snakemake système, paquet dans un venv). On ne déduit
        # pas la disposition, on la CONSTATE en cherchant un script connu, sinon
        # le mode installé recevrait un chemin plausible mais faux.
        _here = Path(workflow.basedir).resolve()          # .../workflow
        _probe = Path("gnn") / "gnn_vgae.py"
        for _cand in (_here.parent / "src",   # clone   : <repo>/src
                      _here.parent):          # installé: <site-packages>/stateshift
            if (_cand / _probe).is_file():
                SRC = str(_cand)
                break
        else:
            raise WorkflowError(
                "Impossible de localiser les scripts du pipeline depuis "
                + str(_here) + ". Installe le paquet (`pip install stateshift`) "
                "dans l'environnement qui exécute snakemake, ou fixe "
                "STATESHIFT_SRC=/chemin/vers/src."
            )

# Interpréteur des règles. `compute.python: "python"` signifie historiquement
# « le python de l'environnement actif » — une hypothèse qui casse dès que le
# PATH pointe ailleurs (un venv d'un autre projet, un nœud de calcul au PATH
# minimal). Le symptôme était un `ModuleNotFoundError: torch` enfoui dans le log
# d'une règle, après quarante minutes de construction du graphe.
#
# On résout donc par CAPACITÉ, pas par nom : l'interpréteur retenu doit savoir
# importer torch. Ordre — variable d'environnement (explicite, gagne toujours),
# puis la valeur configurée si elle convient, puis l'interpréteur qui exécute
# Snakemake. Aucun changement pour un environnement correctement activé.
def _can_import_torch(exe):
    try:
        return subprocess.run([exe, "-c", "import torch"], capture_output=True,
                              timeout=120).returncode == 0
    except Exception:
        return False

def _resolve_python(key, env_var):
    override = os.environ.get(env_var)
    if override:
        return override

    configured = config["compute"].get(key) or ""
    usable = bool(configured) and bool(shutil.which(configured) or Path(configured).is_file())

    if usable and _can_import_torch(configured):
        return configured
    if _can_import_torch(sys.executable):
        if usable:
            sys.stderr.write(
                "\n[stateshift] ⚠️  compute." + key + " = '" + str(configured)
                + "' ne peut pas importer torch.\n"
                "             Utilisation de " + sys.executable + " à la place.\n"
                "             (fixe " + env_var + " pour imposer un interpréteur)\n\n")
        return sys.executable

    # Personne ne sait importer torch : on garde la valeur configurée pour ne pas
    # empêcher un dry-run, mais on le dit AVANT le DAG, pas au milieu.
    sys.stderr.write(
        "\n[stateshift] ⚠️  AUCUN interpréteur disponible ne sait importer torch.\n"
        "             Le DAG se résoudra, mais l'entraînement ÉCHOUERA.\n"
        "             Active l'environnement du projet, ou : pip install "
        "'stateshift[run]'\n"
        "             Diagnostic complet : stateshift doctor\n\n")
    return configured or sys.executable

PY       = _resolve_python("python", "STATESHIFT_PYTHON")
PY_TORCH = _resolve_python("python_torch", "STATESHIFT_PYTHON_TORCH")

VGAE        = config["models"]["vgae"]
RUN_TAG     = VGAE["run_tag"]
SEEDS       = [str(s) for s in VGAE["seeds"]]
TRAIN_VGAE  = VGAE["enabled"]
EXTRA_FLAGS = VGAE.get("extra_flags", "")

MODES      = config["perturbation"]["modes"]
AXIS_TAG   = config["perturbation"].get("axis_tag", "")
OUT_SUFFIX = config["perturbation"].get("out_suffix", "")
# genes_file : restreint la perturbation à un sous-ensemble (nos cibles) via
# --genes-file. Reste en mode --all-genes → MÊME nom de sortie
# (perturbation_all_genes_<mode>.tsv), donc l'aval est inchangé. "" = tous les gènes.
GENES_FILE = config["perturbation"].get("genes_file", "")
# Multi-axe (P4→cluster + transitions inter-cluster) + cache Δz. Défauts = OFF
# → comportement historique inchangé. Cf. LOG #log-multiaxis.
TRANSITION_AXES = config["perturbation"].get("transition_axes", "none")   # none|default|all-pairs
CLUSTER_ANCHOR  = config["perturbation"].get("cluster_anchor_mode", "none")  # none|de-markers|manual
CACHE_DELTA_Z   = bool(config["perturbation"].get("cache_delta_z", True))
# Fichier d'ancres pour cluster_anchor_mode=manual (axe polycentrique). Relatif à
# data_root si non-absolu ; "" → défaut du code (data/gnn_data/ahn_cluster_anchors.tsv).
_ANCHORS_CFG    = str(config["perturbation"].get("cluster_anchors_file", "")).strip()
if _ANCHORS_CFG and not os.path.isabs(_ANCHORS_CFG):
    _ANCHORS_CFG = str(DATA_ROOT / _ANCHORS_CFG)
_MULTI_FLAGS = " ".join(filter(None, [
    # NB : concaténation (pas de f-string) — le parser Snakemake 7.32 × Python
    # 3.12.13 corrompt les f-strings du Snakefile (cf. LOG #arch-tier25-split).
    ("--transition-axes " + str(TRANSITION_AXES)) if TRANSITION_AXES != "none" else "",
    ("--cluster-anchor-mode " + str(CLUSTER_ANCHOR)) if CLUSTER_ANCHOR != "none" else "",
    ("--cluster-anchors-file " + _ANCHORS_CFG) if (CLUSTER_ANCHOR == "manual" and _ANCHORS_CFG) else "",
    ("--cache-delta-z" if CACHE_DELTA_Z else ""),
]))

# Axe PRIMAIRE du driver_score (fixé à la perturbation) :
#   "phenotypic" (défaut) = contraste A→B des cell_groups (P4→P16) ;
#   "de"        = axe DE-ancré (--de-axis-file : pôles = top-N up/down d'un DE) ;
#   "effector"  = axe ancré sur des listes de gènes effecteurs pro/anti (manuel).
# Complémentaire du multi-axe ci-dessus (par-cluster/transition, re-projeté du cache).
_PERT = config["perturbation"]
AXIS_MODE = _PERT.get("axis", "phenotypic")
if AXIS_MODE == "de":
    AXIS_FLAGS = ("--de-axis-file " + str(_PERT.get("de_axis_file", DE_CSV))
                  + " --de-axis-label " + str(_PERT.get("de_axis_label", "sen_vs_pro"))
                  + " --de-axis-rank " + str(_PERT.get("de_axis_rank", "stat")))
elif AXIS_MODE in ("effector", "manual"):
    _ep, _ea = _PERT.get("effector_pro", ""), _PERT.get("effector_anti", "")
    AXIS_FLAGS = ("--effector-axis"
                  + ((" --effector-pro " + str(_ep)) if _ep else "")
                  + ((" --effector-anti " + str(_ea)) if _ea else ""))
else:
    AXIS_FLAGS = ""

# ── F1 (FUT §2.8 / BIB §21.13) : ESTIMATEUR de l'axe global ─────────────────
# Mêmes pôles, direction dérivée autrement. Deux usages DISTINCTS :
#   * axis_method        -> l'estimateur du driver_score HEADLINE, figé à la
#                           perturbation. "diff" = défaut historique.
#   * axis_method_compare-> liste d'estimateurs re-projetés APRÈS coup depuis le
#                           cache Δz (reproject_axes.py) : aucune re-perturbation,
#                           coût ~secondes. C'est la voie à privilégier — elle
#                           donne « N définitions d'axe × mêmes drivers » sans
#                           multiplier les runs, et n'engage pas le headline.
# Motivation : ASNS (cos 0.058→0.514 selon kl1) montre que l'axe PIVOTE avec les
# hyperparamètres ; 'lda' blanchit par la covariance intra-classe, ce qui teste
# précisément cette instabilité. 'pca' est un null NON supervisé.
AXIS_METHOD = str(_PERT.get("axis_method", "diff")).strip() or "diff"
if AXIS_METHOD not in ("diff", "lda", "cav", "pca"):
    raise ValueError("perturbation.axis_method doit être diff|lda|cav|pca, "
                     "reçu : " + AXIS_METHOD)
_AXIS_EST_FLAGS = " ".join(filter(None, [
    ("--axis-method " + AXIS_METHOD) if AXIS_METHOD != "diff" else "",
    ("--axis-lda-shrinkage " + str(_PERT.get("axis_lda_shrinkage", 0.05))
     ) if AXIS_METHOD == "lda" else "",
    ("--axis-cav-top-n " + str(_PERT.get("axis_cav_top_n", 500))
     + " --axis-cav-seed " + str(_PERT.get("axis_cav_seed", 0))
     + " --axis-cav-permutations " + str(_PERT.get("axis_cav_permutations", 0))
     ) if AXIS_METHOD == "cav" else "",
]))
AXIS_FLAGS = (AXIS_FLAGS + " " + _AXIS_EST_FLAGS).strip()

# Comparaison post-hoc (liste, vide = off). Exige le cache Δz.
AXIS_COMPARE = str(_PERT.get("axis_method_compare", "")).strip()
if AXIS_COMPARE and not CACHE_DELTA_Z:
    raise ValueError("perturbation.axis_method_compare exige cache_delta_z: true "
                     "(la comparaison re-projette le cache Δz, elle ne "
                     "re-perturbe pas).")

SCORING        = config["scoring"]
ORA_TOP_N      = config["validation"]["ora_top_n"]
DECOY_ON       = config["validation"]["decoy"]["enabled"]
DECOY_TOP_N    = config["validation"]["decoy"]["top_n"]
# V6.2 (LOG §25bis) : n>=50 obligatoire — a n=3-5 les SD sont sous-estimees ~10x
# et 3 "passages" sur 4 s'evaporent a n=50. L'ancien defaut (3) est non fiable.
DECOY_REWIRES  = config["validation"]["decoy"].get("n_rewires", 50)
DECOY_FROZEN   = config["validation"]["decoy"].get("frozen_axis", False)
# Decoy d'AXE (nul de spécificité) : N axes aléatoires écrits PENDANT perturb
# (perturbation_*_random_axis_<mode>.tsv). 0 = off. Requiert un axe (phenotypic/
# de/effector) ; sans axe le script saute → on ne déclare l'output que si N>0.
RANDOM_AXIS      = int(config["validation"]["decoy"].get("random_axis", 0))
RANDOM_AXIS_SEED = int(config["validation"]["decoy"].get("random_axis_seed", 0))
CLUSTER_ANNOT  = config["validation"]["cluster_annotation"]["enabled"]

# ── Validations branchées le 2026-07-27 (cf. Stage 10) ─────────────────────
# Toutes opt-in, défaut OFF sauf le QC : le DAG historique est inchangé tant
# qu'on ne les active pas. `_v(nom, clé, défaut)` évite de casser les configs
# existantes, qui ne déclarent aucune de ces sections.
def _v(name, key="enabled", default=False):
    return (config["validation"].get(name) or {}).get(key, default)

# QC : les 5 contrôles préalables à toute lecture d'ablation. Défaut ON — ils
# coûtent quelques secondes et leur absence a laissé passer chaque vague
# précédente sans plancher de bruit.
QC_ON        = _v("qc", "enabled", True)
QC_BLOCKING  = _v("qc", "blocking", False)
# `repro` mesure le bruit entre deux runs de la MÊME config. Passer deux seeds
# différents mesurerait la variance de seed, ce qui n'est pas la même chose et
# donnerait un plancher faussement élevé — donc pas de valeur par défaut : les
# deux runs doivent être désignés explicitement, sinon le contrôle est sauté.
_QC_A = str(_v("qc", "repro_a", "") or "").strip()
_QC_B = str(_v("qc", "repro_b", "") or "").strip()
_QC_REPRO_FLAGS = ("--a " + _QC_A + " --b " + _QC_B) if (_QC_A and _QC_B) else ""

PURITY_ON       = _v("purity_source")
PURITY_TARGETS  = " ".join(str(_v("purity_source", "targets", "")).split())
PURITY_N_RANDOM = int(_v("purity_source", "n_random", 200))

H2H_ON      = _v("head_to_head")
H2H_TARGETS = str(_v("head_to_head", "targets", "") or "").strip()

READOUT_SPEC_ON = _v("readout_specificity")
ORA_DE_BASE_ON  = _v("ora_de_baseline")

# Signed cascade (Solution C.1, gnn_futur §8.C) : effector-anchored multi-hop
# signed propagation on the frozen encoder + curated signed graph. Post-hoc,
# seed-invariant for the curated sign → run once on SEEDS[0]. Opt-in, défaut OFF.
CASCADE_ON        = _v("signed_cascade")
CASCADE_SIGN_SRC  = str(_v("signed_cascade", "sign_source", "known") or "known")
CASCADE_ALPHA     = float(_v("signed_cascade", "alpha", 0.85))
CASCADE_HOPS      = int(_v("signed_cascade", "hops", 6))
CASCADE_NORM      = str(_v("signed_cascade", "norm", "sym") or "sym")
_CASC_PRO = str(_v("signed_cascade", "effector_pro", "") or "").strip()
_CASC_ANTI = str(_v("signed_cascade", "effector_anti", "") or "").strip()

if PURITY_ON and not PURITY_TARGETS:
    raise ValueError("validation.purity_source.enabled: true exige "
                     "validation.purity_source.targets (liste de gènes).")

# Racine des runs entraînés (= GNN_OUT_DIR_BASE pour gnn_vgae) et des analyses.
RUNS_DIR     = OUT_BASE
# RÉORG 2026-07-15 : tout ce qui concerne UNE config vit sous OUT_BASE/<run_tag>/
#   → build/, s<seed>/, logs/, analysis/, _graph_cache.pkl. Évite (a) le mélange
#   build/seed et (b) l'écrasement des logs entre configs de la vague (chemins de
#   log étaient partagés). run_tag avec "/" = OK (os.path.join → dossiers imbriqués,
#   cf. _paths.py:66 ; run_tag n'est sinon qu'un champ métadonnée).
CONFIG_DIR   = OUT_BASE / str(RUN_TAG)
ANALYSIS_DIR = CONFIG_DIR / "analysis"
LOG_DIR      = CONFIG_DIR / "logs"

def run_dir(seed):
    """Run dir d'un seed : OUT_BASE/<run_tag>/s<seed> (écrit par gnn_vgae via
    --run-tag <run_tag>/s<seed>)."""
    return CONFIG_DIR / ("s" + str(seed))

# Préfixe de fichier de perturbation : perturbation_all_genes[_<suffix>]_<mode>.tsv
_PSEG = ("_" + str(OUT_SUFFIX)) if OUT_SUFFIX else ""
def perturb_tsv(seed, mode):
    return run_dir(seed) / ("perturbation_all_genes" + _PSEG + "_" + str(mode) + ".tsv")

# Environnement injecté à gnn_vgae (chemins portables).
GNN_ENV = " ".join([
    "GNN_DATA_DIR=" + str(DATA_ROOT),
    "GNN_OUT_DIR_BASE=" + str(RUNS_DIR),
    "GNN_HUMESS_DIR=" + str(HUMESS_DIR),
    "GNN_SCENIC_DIR=" + str(SCENIC_DIR),
])

# Mode déterministe opt-in (compute.deterministic: true) : bit-exact à seed fixe
# (threads=1 + algos déterministes + PYTHONHASHSEED figé pour l'ordre des arêtes).
# ⚠️ threads=1 → build/entraînement plus LENTS (surtout CPU). À réserver aux runs
# de reproductibilité. GNN_DETERMINISTIC est aussi injecté aux perturbations.
DETERMINISTIC = config.get("compute", {}).get("deterministic", False)
if DETERMINISTIC:
    GNN_ENV += " GNN_DETERMINISTIC=1 PYTHONHASHSEED=0"

# ──────────────────────────────────────────────────────────────────
# Stage 0 — build features data-dérivées (coexpr + HuMess) — OPTIONNEL
#   build.enabled=true → orchestre prep/coexpr/HuMess depuis une matrice via
#   run_v6_build.sh (lui-même cache-aware). Sinon (HUVEC, précalculé) : les
#   fichiers coexpr/HuMess sont des entrées externes, build_features inactif.
#   « Démarrer à l'assemblage » = natif : si coexpr_diff.tsv + cs_gene_to_
#   importance existent déjà, Snakemake saute build_features.
# ──────────────────────────────────────────────────────────────────
BUILD        = config.get("build", {})
BUILD_ON     = BUILD.get("enabled", False)
HUMESS_CONDS = BUILD.get("conditions", ["pro", "sen"])

def humess_importance_files():
    return [str(HUMESS_DIR / "models" / c / "cs" / ("cs_gene_to_importance_" + str(c) + ".tsv"))
            for c in HUMESS_CONDS]

def build_inputs():
    """Entrées amont (coexpr + HuMess) pour train, seulement si build activé.
    Si les fichiers existent → build_features sauté (start-from-assembly)."""
    return ([COEXPR] + humess_importance_files()) if BUILD_ON else []

# ── DÉCRIRE son dataset ≠ RECONSTRUIRE ses features ────────────────────────
# Jusqu'au 2026-07-27 les variables d'env qui DÉCRIVENT le dataset (groupes,
# matrice, samplesheet) n'étaient injectées que sous `build.enabled: true`, qui
# déclenche AUSSI la reconstruction lourde coexpr+HuMess. Conséquence : aucun
# moyen de faire tourner un dataset bulk déjà préparé — ni un jeu minuscule.
# Les deux sont désormais séparés. Le bloc `dataset:` prime ; sans lui,
# `build.enabled` garde son comportement historique (rétro-compatible).
_DS = config.get("dataset", {}) or {}
_DS_GROUPS = str(_DS.get("cell_groups", "") or "").strip()
_DS_MATRIX = str(_DS.get("expr_matrix", "") or "").strip()
_DS_META   = str(_DS.get("group_meta", "") or "").strip()

def _abs_to_data_root(p):
    """Chemin relatif → relatif à data_root (comme le reste de la config)."""
    return p if (not p or os.path.isabs(p)) else str(DATA_ROOT / p)

TRAIN_COEXPR_FLAGS = ""
if _DS_GROUPS or _DS_MATRIX or _DS_META:
    if not (_DS_GROUPS and _DS_MATRIX and _DS_META):
        raise ValueError(
            "dataset: exige les TROIS clés ensemble — cell_groups, expr_matrix, "
            "group_meta. Une seule manquante et gnn_vgae repart en mode scRNA "
            "HUVEC, qui cherchera merged_P4_P16_metadata.csv.")
    # expr_matrix ET group_meta sont donnés RELATIVEMENT à data_root et rendus
    # absolus par _abs_to_data_root → sous-dossiers préservés (ex.
    # pyscenic/<dataset>/expr_all.csv). Le code fait os.path.join(GNN_DATA_DIR,
    # EXPR_MATRIX) : un chemin absolu y est renvoyé tel quel. GROUP_META est
    # ouvert directement. (Historique : EXPR_MATRIX prenait le basename seul, ce
    # qui cassait tout expr matrix hors de la racine data_root.)
    GNN_ENV += " " + " ".join([
        "GNN_CELL_GROUPS=" + _DS_GROUPS,
        "GNN_HUMESS_CONDITIONS=" + _DS_GROUPS,
        "GNN_EXPR_MATRIX=" + _abs_to_data_root(_DS_MATRIX),
        "GNN_GROUP_META=" + _abs_to_data_root(_DS_META),
    ])
elif BUILD_ON:
    # Mode BULK historique : les sorties de prep vivent à côté du coexpr_file.
    _coex_dir = str(Path(COEXPR).parent)
    _conds = ",".join(HUMESS_CONDS)
    GNN_ENV += " " + " ".join([
        "GNN_CELL_GROUPS=" + _conds,
        "GNN_HUMESS_CONDITIONS=" + _conds,
        "GNN_EXPR_MATRIX=" + _coex_dir + "/expr_all.csv",
        "GNN_GROUP_META=" + _coex_dir + "/samplesheet.tsv",
    ])

if BUILD_ON:
    TRAIN_COEXPR_FLAGS = "--coexpr-mode differential --diff-coexpr-file " + str(COEXPR)

# ── Pôles de l'axe d'état ───────────────────────────────────────────────────
# `perturb_top_genes` a pour défauts --quiescent-groups P4 et des cibles
# P16_cluster_0..3 : la structure HUVEC à 5 groupes, codée en dur. Sur tout
# autre dataset l'axe échouait en KeyError('mean_P16_cluster_1'). Ces deux
# drapeaux existaient mais n'étaient exposés nulle part dans le workflow.
# `dataset.pole_a` = origine (état de départ), `pole_b` = destination.
_POLE_A = str(_DS.get("pole_a", "") or "").strip()
_POLE_B = str(_DS.get("pole_b", "") or "").strip()
if (_POLE_A or _POLE_B) and not (_POLE_A and _POLE_B):
    raise ValueError("dataset.pole_a et dataset.pole_b vont par paire "
                     "(origine et destination de la transition).")
# Défaut : les deux premiers cell_groups déclarés, dans l'ordre. Sur un dataset
# à deux états c'est la seule lecture sensée, et cela évite d'imposer une
# redite. Au-delà de deux groupes, mieux vaut être explicite.
if not _POLE_A and _DS_GROUPS:
    _g = [g.strip() for g in _DS_GROUPS.split(",") if g.strip()]
    if len(_g) == 2:
        _POLE_A, _POLE_B = _g[0], _g[1]
POLE_FLAGS = (("--quiescent-groups " + _POLE_A + " --p16-groups " + _POLE_B)
              if (_POLE_A and _POLE_B) else "")

# Sous-ensemble de GNN_ENV utile aux étapes AVAL (perturbation) : elles ne
# reconstruisent pas le graphe mais doivent en partager la description.
DATASET_ENV = ("GNN_CELL_GROUPS=" + _DS_GROUPS) if _DS_GROUPS else ""

# ──────────────────────────────────────────────────────────────────
# Split build ↔ train (depuis le refactor modulaire de gnn_vgae) :
#   GRAPH_FLAGS = flags qui AFFECTENT le graphe (§1-7) → DOIVENT être identiques
#   entre `build_graph` (--build-only) et `train_vgae` (--reuse-graph), sinon la
#   signature de cache diffère et le graphe est reconstruit. --seed/--run-tag sont
#   dans _TRAIN_ONLY (exclus de la signature) → un seul cache sert tous les seeds.
#   GRAPH_CACHE : un cache par run_tag (seed-indépendant), bâti 1× puis réutilisé.
GRAPH_FLAGS = (str(EXTRA_FLAGS) + " " + str(TRAIN_COEXPR_FLAGS)).strip()
GRAPH_CACHE = CONFIG_DIR / "_graph_cache.pkl"


# ──────────────────────────────────────────────────────────────────
# Cible finale
# ──────────────────────────────────────────────────────────────────
def final_targets():
    t = [
        ANALYSIS_DIR / "cross_seed_gene_ranking.tsv",
        ANALYSIS_DIR / "interpret" / "driver_baselines.tsv",
        ANALYSIS_DIR / "interpret" / "ora" / ("top" + str(ORA_TOP_N) + "_reactome.tsv"),
        ANALYSIS_DIR / "interpret" / "ora" / ("top" + str(ORA_TOP_N) + "_aging.tsv"),
        ANALYSIS_DIR / "report" / "SUMMARY.md",
    ]
    if AXIS_COMPARE:
        t.append(ANALYSIS_DIR / "axis_methods" / "axis_method_comparison.tsv")
    if DECOY_ON:
        t.append(ANALYSIS_DIR / "interpret" / "decoy_confidence.tsv")
    if CLUSTER_ANNOT:
        t.append(ANALYSIS_DIR / "cluster_annotation" / "cluster_annotation_cross_seed.tsv")
    # Validations branchées (Stage 10). Le QC est le seul actif par défaut.
    if QC_ON:
        t.append(ANALYSIS_DIR / "qc" / "qc_report.md")
    if PURITY_ON:
        t.append(ANALYSIS_DIR / "interpret" / "purity" / "mediate.tsv")
    if H2H_ON:
        t.append(ANALYSIS_DIR / "interpret" / "head_to_head_baselines.tsv")
    if READOUT_SPEC_ON:
        t.append(ANALYSIS_DIR / "interpret" / "readout_specificity.tsv")
    if ORA_DE_BASE_ON:
        t.append(ANALYSIS_DIR / "interpret" / "ora" / "de_baseline"
                 / "comparison_summary.tsv")
    if CASCADE_ON:
        t.append(ANALYSIS_DIR / "interpret" / "signed_cascade.tsv")
    t.extend(EXTRA_TARGETS)
    return t


# ──────────────────────────────────────────────────────────────────
# Local extensions — rules that are NOT part of the published tool
# ──────────────────────────────────────────────────────────────────
# Some rules drive artefacts of one specific write-up (thesis figures, its
# appendices) rather than the pipeline itself. They are real rules, they must
# keep working here, and they must not ship: a rule whose `shell:` names a
# script absent from the wheel fails mid-DAG, after the graph build — the exact
# failure mode `tests/test_package_layout.py` was written to prevent.
#
# So they live in `rules/*.local.smk`, which `.gitignore` excludes. Present →
# included; absent → the DAG is simply smaller. A local rule adds its own
# targets by appending to EXTRA_TARGETS, which is why this include has to run
# BEFORE `rule all` evaluates `final_targets()`.
EXTRA_TARGETS = []

for _local in sorted((Path(workflow.basedir) / "rules").glob("*.local.smk")):
    include: str(_local)


rule all:
    input:
        final_targets()


# ──────────────────────────────────────────────────────────────────
# Stage 0 — build_features : prep → coexpr → HuMess (wrappe run_v6_build.sh)
# ──────────────────────────────────────────────────────────────────
rule build_features:
    output:
        coexpr=COEXPR,
        humess=humess_importance_files(),
    params:
        matrix=BUILD.get("matrix", ""),
        metadata=BUILD.get("metadata", ""),
        gene_col=BUILD.get("gene_col", "Tracking_id"),
        group_col=BUILD.get("group_col", 2),
        young=BUILD.get("young_group", "pro"),
        sen=BUILD.get("sen_group", "sen"),
        out_dir=str(Path(COEXPR).parent),
        humess_out=str(HUMESS_DIR),
        repo=BUILD.get("humess_repo", "../humess"),
        cs=BUILD.get("humess_cs_nsamples", 1000),
    log:
        LOG_DIR / "build_features.log",
    threads: 8
    resources:
        mem_mb=16000,
        runtime=1440,
    shell:
        "V6_PY={PY} HUMESS_REPO={params.repo} V6_HUMESS_CS={params.cs} "
        "bash scripts/run_v6_build.sh --matrix {params.matrix} "
        "--gene-col {params.gene_col} --group-col {params.group_col} "
        "--metadata {params.metadata} --young-group {params.young} "
        "--sen-group {params.sen} --out-dir {params.out_dir} "
        "--humess-out {params.humess_out} &> {log}"


# ──────────────────────────────────────────────────────────────────
# Stage 6 — Train VGAE (1 run par seed)
#   gnn_vgae.py construit le graphe ET entraîne (monolithe). Sorties dans
#   OUT_DIR_BASE/<run_tag>.s<seed>/. --run-tag fixe le nom (sinon "auto").
#   input build = coexpr+HuMess si build activé (sinon entrées externes).
# ──────────────────────────────────────────────────────────────────
rule build_graph:
    """Stage 6a — Construit le graphe hétérogène §1-7 UNE fois (seed-indépendant)
    et écrit le cache, via gnn_vgae --build-only. Tous les seeds le réutilisent
    (--reuse-graph) → §1-7 (~40 min) n'est plus refait 3×. Mêmes GRAPH_FLAGS que
    train_vgae ⇒ signature de cache compatible."""
    input:
        build=build_inputs(),
    output:
        cache=GRAPH_CACHE,
    log:
        LOG_DIR / "build_graph.log",
    threads: 4
    resources:
        mem_mb=32000,
        runtime=120,
    shell:
        "{GNN_ENV} {PY} {SRC}/gnn/gnn_vgae.py --build-only "
        "--run-tag {RUN_TAG}/build --graph-cache {output.cache} "
        "{GRAPH_FLAGS} &> {log}"


rule train_vgae:
    """Stage 6b — Entraîne 1 run par seed en RÉUTILISANT le cache de build_graph
    (--reuse-graph). Les mêmes GRAPH_FLAGS garantissent que le cache est validé."""
    input:
        cache=GRAPH_CACHE,
        build=build_inputs(),
    output:
        model=run_dir("{seed}") / "best_vgae.pt",
        ranking=run_dir("{seed}") / "gene_ranking_vgae.csv",
        group_expr=run_dir("{seed}") / "group_expression.tsv",
    log:
        LOG_DIR / "train_vgae_s{seed}.log",
    threads: 4
    resources:
        mem_mb=32000,
        runtime=720,    # minutes
        gpu=1,          # mappé vers --gres=gpu:1 par le profil cluster
    shell:
        "{GNN_ENV} {PY} {SRC}/gnn/gnn_vgae.py "
        "--seed {wildcards.seed} --run-tag {RUN_TAG}/s{wildcards.seed} "
        "--reuse-graph --graph-cache {input.cache} "
        "{GRAPH_FLAGS} &> {log}"


# ──────────────────────────────────────────────────────────────────
# Stage 7 — Perturbation in silico (KO/KD/OE, all-genes), 1 job par seed
# ──────────────────────────────────────────────────────────────────
rule perturb:
    # 1 JOB PAR (seed, mode) : wildcard {mode} → parallélisation cluster.
    # + de modes = + de jobs (1 chacun) ; + de seeds = + de jobs (1 par seed×mode).
    input:
        model=run_dir("{seed}") / "best_vgae.pt" if TRAIN_VGAE else [],
    output:
        # Sortie principale + (si decoy d'axe activé) la nulle random_axis, écrite
        # par le même run perturb → déclarée en output SEULEMENT si RANDOM_AXIS>0.
        ([run_dir("{seed}") / ("perturbation_all_genes" + _PSEG + "_{mode}.tsv")]
         + ([run_dir("{seed}") / ("perturbation_all_genes" + _PSEG + "_random_axis_{mode}.tsv")]
            if RANDOM_AXIS > 0 else [])),
    params:
        rd=lambda wc: run_dir(wc.seed),
        # perturb_top_genes CONCATÈNE le suffixe brut ("perturbation_all_genes"
        # + suffix) : il faut donc passer "_axisV4", pas "axisV4". Sans le
        # souligné, le script écrivait "perturbation_all_genesaxisV4_ko.tsv"
        # alors que _PSEG déclare "perturbation_all_genes_axisV4_ko.tsv" →
        # MissingOutputException pour TOUT out_suffix non vide (corrigé 2026-07-29).
        suffix=(("--out-suffix " + _PSEG) if OUT_SUFFIX else ""),
        genes=(("--genes-file " + str(GENES_FILE)) if GENES_FILE else ""),
        multi=_MULTI_FLAGS,
        axis=AXIS_FLAGS,
        rndaxis=(("--random-axis " + str(RANDOM_AXIS)
                  + " --random-axis-seed " + str(RANDOM_AXIS_SEED))
                 if RANDOM_AXIS > 0 else ""),
    log:
        LOG_DIR / "perturb_s{seed}_{mode}.log",
    threads: 8
    resources:
        mem_mb=32000,
        runtime=1200,   # 20 h : all-genes ×11k gènes frôle/dépasse 8 h (mur qos short=24 h)
    shell:
        # GNN_CELL_GROUPS doit être injecté ICI aussi : gnn_perturbation lit
        # la même variable pour ordonner les noeuds cell_group. Sans elle, la
        # perturbation retombe sur les 5 groupes HUVEC et échoue en KeyError
        # sur tout autre dataset, alors que le graphe, lui, était correct.
        "{DATASET_ENV} {PY} {SRC}/perturbation/perturb_top_genes.py "
        "--run-dir {params.rd} --all-genes --modes {wildcards.mode} "
        "--device {DEVICE} {params.suffix} {params.genes} {params.multi} "
        "{params.axis} {params.rndaxis} {POLE_FLAGS} &> {log}"


# ──────────────────────────────────────────────────────────────────
# Stage 8 — Agrégation cross-seed → driver_score (perturb_report)
# ──────────────────────────────────────────────────────────────────
rule aggregate_cross_seed:
    input:
        expand(
            # NB : pas de f-string à double-accolade ({{mode}}) — fragile selon la
            # version de Snakemake (parsing des wildcards). Concaténation simple :
            # {seed} vient de run_dir, {mode} est un wildcard littéral pour expand.
            str(run_dir("{seed}")) + "/perturbation_all_genes" + _PSEG + "_{mode}.tsv",
            seed=SEEDS, mode=MODES,
        ),
    output:
        ranking=ANALYSIS_DIR / "cross_seed_gene_ranking.tsv",
    params:
        runs=[str(run_dir(s)) for s in SEEDS],
        report_dir=ANALYSIS_DIR,
        # ALWAYS pass --axis-tag, including when it is empty (2026-07-29 fix).
        # perturb_report distinguishes axis_tag="" (only suffix-less TSVs, i.e.
        # the V3 naming) from axis_tag=None (match EVERYTHING). Dropping the
        # flag on a falsy AXIS_TAG sent None, so the cross-seed glob
        # `perturbation_all_*.tsv` also swallowed the DIAGNOSTIC families
        # written by the same perturb job — `_random_axis_<mode>.tsv` (axis
        # null) and `_signed_fanout_<mode>.tsv` (one row per EDGE) — whose
        # `target`/`mode` columns look like real rows but carry none of the
        # proj_signed_* metrics. Measured on the completed V6.1.3 rfi2 wave:
        # n_seeds_present up to 1480 instead of <=3, robustness_score up to
        # 740, and avg_proj_signed_diff divided by the fan-out in-degree
        # (TP53 0.0148 instead of ~10.9) => a degree-weighted artefact.
        axis=('--axis-tag "' + str(AXIS_TAG) + '"'),
        de_sig=SCORING["de_significance"],
        padj=SCORING["de_padj_max"],
        lfc=SCORING["de_abs_lfc_min"],
    log:
        LOG_DIR / "aggregate_cross_seed.log",
    threads: 4
    shell:
        "{PY} {SRC}/validation/reports/perturb_report.py --cross-seed {params.runs} "
        "--report-dir {params.report_dir} {params.axis} "
        "--de-magnitude-csv {DE_CSV} --coexpr-degree-file {COEXPR} "
        "--de-significance {params.de_sig} --de-padj-max {params.padj} "
        "--de-abs-lfc-min {params.lfc} --no-signed-fanout &> {log}"


# ──────────────────────────────────────────────────────────────────
# Stage 8a-bis — F1 : comparaison d'ESTIMATEURS d'axe (opt-in)
#   Re-projette le cache Δz sur N définitions de l'axe global — AUCUNE
#   re-perturbation, donc quelques secondes. Répond à « les mêmes drivers
#   sortent-ils quelle que soit la façon de tracer l'axe ? », qui est le seul
#   contrôle direct de l'axe flottant (ASNS : cos 0.058→0.514 selon kl1).
#   'pca' sert de NULL non supervisé : s'il donne les mêmes drivers que 'diff',
#   l'axe n'apporte rien que la variance dominante du latent ne donne déjà.
# ──────────────────────────────────────────────────────────────────
rule axis_method_compare:
    """F1 — N définitions d'axe × mêmes drivers, depuis le cache Δz."""
    input:
        ranking=ANALYSIS_DIR / "cross_seed_gene_ranking.tsv",
    output:
        cmp=ANALYSIS_DIR / "axis_methods" / "axis_method_comparison.tsv",
    params:
        runs=[str(run_dir(s)) for s in SEEDS],
        out_dir=ANALYSIS_DIR / "axis_methods",
        methods=AXIS_COMPARE,
        shrink=_PERT.get("axis_lda_shrinkage", 0.05),
        cav_n=_PERT.get("axis_cav_top_n", 500),
        cav_seed=_PERT.get("axis_cav_seed", 0),
        cav_perm=_PERT.get("axis_cav_permutations", 0),
    log:
        LOG_DIR / "axis_method_compare.log",
    shell:
        "{PY_TORCH} {SRC}/perturbation/reproject_axes.py "
        "--run-dirs {params.runs} --out {params.out_dir} "
        "--axis-method {params.methods} "
        "--axis-lda-shrinkage {params.shrink} "
        "--axis-cav-top-n {params.cav_n} --axis-cav-seed {params.cav_seed} "
        "--axis-cav-permutations {params.cav_perm} &> {log}"


# ──────────────────────────────────────────────────────────────────
# Stage 8b — Interprétation & validation post-perturbation
# ──────────────────────────────────────────────────────────────────
rule driver_baselines:
    """Le driver_score bat-il les baselines triviales (degré-contrôlé) ?"""
    input:
        ranking=ANALYSIS_DIR / "cross_seed_gene_ranking.tsv",
    output:
        baselines=ANALYSIS_DIR / "interpret" / "driver_baselines.tsv",
    log:
        LOG_DIR / "driver_baselines.log",
    shell:
        "{PY} {SRC}/validation/reports/driver_baselines.py "
        "--ranking {input.ranking} --coexpr-file {COEXPR} "
        "--out {output.baselines} &> {log}"


rule interpret_embedding:
    """Interprétation non-supervisée axe-libre : Louvain(z) + UMAP + ORA + ShinyGO."""
    input:
        ranking=ANALYSIS_DIR / "cross_seed_gene_ranking.tsv",
        model=run_dir(SEEDS[0]) / "best_vgae.pt" if TRAIN_VGAE else [],
    output:
        communities=ANALYSIS_DIR / "interpret" / "communities.tsv",
    params:
        rd=run_dir(SEEDS[0]),
        out_dir=ANALYSIS_DIR / "interpret",
    log:
        LOG_DIR / "interpret_embedding.log",
    shell:
        "{PY_TORCH} {SRC}/validation/viz/interpret_embedding.py "
        "--run-dir {params.rd} --ranking {input.ranking} --shinygo "
        "--out-dir {params.out_dir} &> {log}"


rule perturb_decoy:
    """Null-models décoy N2/N4 (opt-in, torch) → colonne decoy_confidence."""
    input:
        ranking=ANALYSIS_DIR / "cross_seed_gene_ranking.tsv",
    output:
        decoy=ANALYSIS_DIR / "interpret" / "decoy_confidence.tsv",
    params:
        rd=run_dir(SEEDS[0]),
        top_n=DECOY_TOP_N,
        rewires=DECOY_REWIRES,
        frozen=("--frozen-axis" if DECOY_FROZEN else ""),
    resources:
        # top_n * rewires * 2 encodages (ex. 40*50*2 = 4000) : le défaut profil
        # (mem 8000 / runtime 120) le tue vers le gène 30/40. Cf. LOG.
        mem_mb=16000,
        runtime=720,
    log:
        LOG_DIR / "perturb_decoy.log",
    shell:
        "{PY_TORCH} {SRC}/validation/explain/perturb_decoy.py confidence "
        "--run-dir {params.rd} --ranking {input.ranking} "
        "--top-n {params.top_n} --n-rewires {params.rewires} {params.frozen} "
        "--out {output.decoy} &> {log}"


# ──────────────────────────────────────────────────────────────────
# Stage 9 — Validation ORA (Reactome + aging) + cluster_annotation
# ──────────────────────────────────────────────────────────────────
rule ora_top_drivers:
    input:
        ranking=ANALYSIS_DIR / "cross_seed_gene_ranking.tsv",
    output:
        reactome=ANALYSIS_DIR / "interpret" / "ora" / ("top" + str(ORA_TOP_N) + "_reactome.tsv"),
        aging=ANALYSIS_DIR / "interpret" / "ora" / ("top" + str(ORA_TOP_N) + "_aging.tsv"),
        genes=ANALYSIS_DIR / "interpret" / "ora" / ("top" + str(ORA_TOP_N) + "_drivers.txt"),
    params:
        top_n=ORA_TOP_N,
    log:
        LOG_DIR / "ora_top_drivers.log",
    shell:
        # mkdir -p : garde-fou (en cluster/NFS le dossier de sortie n'est pas
        # toujours pré-créé à temps → la 1re redirection `>` échouait). top-N
        # drivers (col1=gène, tri par driver_score col2) → ORA hypergéométrique.
        'mkdir -p "$(dirname {output.genes})" "$(dirname {log})" && '
        # NB : `sort | head -N` échoue sous `set -o pipefail` (Snakemake strict) —
        # head ferme le pipe → sort reçoit SIGPIPE (exit 141) → pipefail. On prend
        # le top-N avec awk (lit tout le flux, pas de fermeture précoce).
        "tail -n +2 {input.ranking} | sort -t$'\\t' -k2,2 -gr | "
        "awk -F'\\t' -v n={params.top_n} 'NR<=n{{print $1}}' > {output.genes} 2> {log} && "
        "{PY} {SRC}/validation/ora/ora_consensus.py --genes {output.genes} "
        "--db reactome --out {output.reactome} &>> {log} && "
        "{PY} {SRC}/validation/ora/ora_consensus.py --genes {output.genes} "
        "--db aging --out {output.aging} &>> {log}"


rule cluster_annotation:
    """Annotation biologique cross-seed des cell_groups (group_expression.tsv)."""
    input:
        ge=expand(str(run_dir("{seed}") / "group_expression.tsv"), seed=SEEDS),
    output:
        annot=ANALYSIS_DIR / "cluster_annotation" / "cluster_annotation_cross_seed.tsv",
    params:
        out_dir=ANALYSIS_DIR / "cluster_annotation",
    log:
        LOG_DIR / "cluster_annotation.log",
    shell:
        "{PY} {SRC}/validation/cluster/cluster_annotation.py "
        "--cross-seed-runs {input.ge} --out-dir {params.out_dir} &> {log}"


# ══════════════════════════════════════════════════════════════════
# Stage 10 — VALIDATIONS BRANCHÉES (2026-07-27)
#
# Cinq modules de validation existaient mais n'étaient appelés de NULLE PART —
# ni ici, ni dans un run_*.sh. Ils tournaient à la main, donc pas du tout :
# `pipeline_qc.py` le dit lui-même dans sa docstring (« None of them was part
# of the pipeline, so every wave shipped without them »). Les voici câblés.
#
# Tous sont pilotés par `validation.<nom>.enabled` et n'entrent dans
# `final_targets()` que si activés — le DAG par défaut est donc inchangé.
# ══════════════════════════════════════════════════════════════════

rule pipeline_qc:
    """Les 5 contrôles qui doivent passer AVANT de lire une ablation.

    plancher de bruit · multiplicité d'arêtes · recouvrement de sources ·
    confusion degré↔readout · spécificité d'axe.

    Chacun a attrapé un défaut réel (PPI stocké 2×, tf_curated ⊂
    transcriptional à 99.9 %, ρ 0.556 entre runs identiques). Le script sort
    en 1 si un contrôle BLOQUANT échoue ; `validation.qc.blocking` décide si
    cela fait tomber la règle ou seulement le rapport.
    """
    input:
        ranking=ANALYSIS_DIR / "cross_seed_gene_ranking.tsv",
    output:
        report=ANALYSIS_DIR / "qc" / "qc_report.md",
    params:
        wave=CONFIG_DIR,
        rd=run_dir(SEEDS[0]),
        repro=_QC_REPRO_FLAGS,
        # Non bloquant par défaut : le rapport doit exister même quand un
        # contrôle échoue, sinon on perd précisément le diagnostic qu'on
        # cherchait. Passer validation.qc.blocking: true pour barrer une vague.
        guard=("" if QC_BLOCKING else " || true"),
    log:
        LOG_DIR / "pipeline_qc.log",
    shell:
        'mkdir -p "$(dirname {output.report})" "$(dirname {log})" && '
        "{PY} {SRC}/validation/qc/pipeline_qc.py all "
        "--wave {params.wave} --run-dir {params.rd} {params.repro} "
        "--out {output.report} &> {log}{params.guard}"


rule purity_source_attribution:
    """D'OÙ vient la purity qui classe une cible, et quelle SOURCE la porte ?

    Encodeur gelé, post-hoc sur Δz. `decompose` = contribution alignée par
    distance 1/2-hop ; `mediate` = ablation ciblée des arêtes incidentes par
    source + nulle d'axe aléatoire. C'est la réponse à l'objection « ces cibles
    tiennent sur une seule source ».
    """
    input:
        ranking=ANALYSIS_DIR / "cross_seed_gene_ranking.tsv",
        # Conditionnel comme interpret_embedding / signed_cascade : sous
        # `models.vgae.enabled: false` (config .-dz, qui REJOUE des checkpoints
        # de juin) déclarer le modèle en entrée ferait remonter build_graph +
        # train_vgae dans le DAG — soit exactement le ré-entraînement que ce
        # mode existe pour éviter. Le checkpoint est de toute façon lu par le
        # script via --run-dir.
        model=run_dir(SEEDS[0]) / "best_vgae.pt" if TRAIN_VGAE else [],
    output:
        decompose=ANALYSIS_DIR / "interpret" / "purity" / "decompose.tsv",
        mediate=ANALYSIS_DIR / "interpret" / "purity" / "mediate.tsv",
    params:
        rd=run_dir(SEEDS[0]),
        targets=PURITY_TARGETS,
        n_random=PURITY_N_RANDOM,
    log:
        LOG_DIR / "purity_source_attribution.log",
    shell:
        'mkdir -p "$(dirname {output.decompose})" "$(dirname {log})" && '
        "{PY_TORCH} {SRC}/validation/explain/purity_source_attribution.py decompose "
        "--run-dir {params.rd} --ranking {input.ranking} "
        "--targets {params.targets} --device {DEVICE} "
        "--out {output.decompose} &> {log} && "
        "{PY_TORCH} {SRC}/validation/explain/purity_source_attribution.py mediate "
        "--run-dir {params.rd} --ranking {input.ranking} "
        "--targets {params.targets} --device {DEVICE} "
        "--n-random {params.n_random} --out {output.mediate} &>> {log}"


rule head_to_head_baselines:
    """Un outil PLUS SIMPLE sort-il les mêmes cibles que le GNN ?

    Reconstruit sans GNN les baselines de chaque source (feature d'importance,
    betweenness par source et combinée) et les confronte au driver_score.
    C'est la preuve que le ranking n'est pas re-dérivable trivialement.
    """
    input:
        ranking=ANALYSIS_DIR / "cross_seed_gene_ranking.tsv",
    output:
        h2h=ANALYSIS_DIR / "interpret" / "head_to_head_baselines.tsv",
    params:
        humess=HUMESS_DIR,
        coexpr=COEXPR,
        targets=(" --targets " + str(H2H_TARGETS)) if H2H_TARGETS else "",
    log:
        LOG_DIR / "head_to_head_baselines.log",
    shell:
        'mkdir -p "$(dirname {output.h2h})" "$(dirname {log})" && '
        "{PY} {SRC}/validation/reports/head_to_head_baselines.py "
        "--ranking {input.ranking} --humess-dir {params.humess} "
        "--coexpr-file {params.coexpr}{params.targets} "
        "--out {output.h2h} &> {log}"


rule readout_specificity:
    """Diagnostics de readout SANS confusion de degré, depuis le cache Δz.

    Sur graphe dépouillé le signal décroît avec le degré ; ces métriques
    séparent l'effet réel de l'artefact structurel.
    """
    input:
        ranking=ANALYSIS_DIR / "cross_seed_gene_ranking.tsv",
        # Conditionnel : cf. purity_source_attribution ci-dessus.
        model=run_dir(SEEDS[0]) / "best_vgae.pt" if TRAIN_VGAE else [],
    output:
        spec=ANALYSIS_DIR / "interpret" / "readout_specificity.tsv",
    params:
        rd=run_dir(SEEDS[0]),
        mode=MODES[0],
    log:
        LOG_DIR / "readout_specificity.log",
    shell:
        'mkdir -p "$(dirname {output.spec})" "$(dirname {log})" && '
        "{PY_TORCH} {SRC}/validation/explain/readout_specificity.py "
        "--run-dir {params.rd} --ranking {input.ranking} "
        "--mode {params.mode} --out {output.spec} &> {log}"


rule ora_de_baseline:
    """ORA sur le DE seul — le comparateur obligatoire du GNN.

    Sans lui, rien ne dit que l'enrichissement du top-drivers apporte quoi que
    ce soit au-dessus d'un simple tri par statistique DE.

    On lui passe le top-N drivers DE CE RUN (`--gnn-genes`), pas le consensus
    V3 de 2024 qui était son défaut : ces runs n'existent plus, et la question
    posée porte sur la config courante. Sortie = le TSV de comparaison
    (recouvrement gènes + pathways), pas la sortie console.
    """
    input:
        genes=ANALYSIS_DIR / "interpret" / "ora" / ("top" + str(ORA_TOP_N) + "_drivers.txt"),
    output:
        ora=ANALYSIS_DIR / "interpret" / "ora" / "de_baseline" / "comparison_summary.tsv",
    params:
        top_n=ORA_TOP_N,
        out_dir=ANALYSIS_DIR / "interpret" / "ora" / "de_baseline",
    log:
        LOG_DIR / "ora_de_baseline.log",
    shell:
        'mkdir -p "{params.out_dir}" "$(dirname {log})" && '
        "{PY} {SRC}/validation/ora/ora_de_baseline.py "
        "--top-k {params.top_n} --gnn-genes {input.genes} "
        "--out-dir {params.out_dir} &> {log}"


rule signed_cascade:
    """Solution C.1 — effector-anchored signed cascade (gnn_futur §8.C).

    Multi-hop generalisation of the 1-hop signed fan-out: propagates the role of
    a small effector core UPSTREAM by sign composition (structural balance,
    Harary 1953 ; cf. CARNIVAL/VIPER/CellOracle). Runs on the FROZEN encoder +
    the curated signed graph — no re-training, seed-invariant for the curated
    sign → computed once on SEEDS[0]. Emits per-gene cascade_role/coherence/
    reach/score (non-ranking, joined for arbitration cross-dataset).
    """
    input:
        model=run_dir(SEEDS[0]) / "best_vgae.pt" if TRAIN_VGAE else [],
    output:
        casc=ANALYSIS_DIR / "interpret" / "signed_cascade.tsv",
    params:
        rd=run_dir(SEEDS[0]),
        sign_src=CASCADE_SIGN_SRC,
        alpha=CASCADE_ALPHA,
        hops=CASCADE_HOPS,
        norm=CASCADE_NORM,
        pro=(("--effector-pro " + _CASC_PRO) if _CASC_PRO else ""),
        anti=(("--effector-anti " + _CASC_ANTI) if _CASC_ANTI else ""),
    log:
        LOG_DIR / "signed_cascade.log",
    shell:
        'mkdir -p "$(dirname {output.casc})" "$(dirname {log})" && '
        "{PY_TORCH} {SRC}/perturbation/signed_cascade.py "
        "--run-dir {params.rd} --sign-source {params.sign_src} "
        "--alpha {params.alpha} --hops {params.hops} --norm {params.norm} "
        "{params.pro} {params.anti} --device {DEVICE} "
        "--out {output.casc} &> {log}"


# ──────────────────────────────────────────────────────────────────
# Stage 11 — Report final (synthèse markdown des sorties clés)
# ──────────────────────────────────────────────────────────────────
rule report:
    input:
        ranking=ANALYSIS_DIR / "cross_seed_gene_ranking.tsv",
        baselines=ANALYSIS_DIR / "interpret" / "driver_baselines.tsv",
        communities=ANALYSIS_DIR / "interpret" / "communities.tsv",
        reactome=ANALYSIS_DIR / "interpret" / "ora" / ("top" + str(ORA_TOP_N) + "_reactome.tsv"),
        aging=ANALYSIS_DIR / "interpret" / "ora" / ("top" + str(ORA_TOP_N) + "_aging.tsv"),
    output:
        summary=ANALYSIS_DIR / "report" / "SUMMARY.md",
    params:
        name=config["run"]["name"],
        seeds=", ".join(SEEDS),
        modes=", ".join(MODES),
        axe=(AXIS_TAG or "V3 (P4)"),
        n_seeds=str(len(SEEDS)),
    run:
        # Concaténation simple (pas de f-string : le parseur run-block de
        # Snakemake 7.x ne supporte pas les f-strings à appels/quotes inline).
        lines = [
            "# Pipeline VGAE HUVEC — " + params.name,
            "",
            "- run_tag : `" + RUN_TAG + "` (" + params.n_seeds + " seeds : " + params.seeds + ")",
            "- device perturbation : `" + DEVICE + "`",
            "- axe : `" + params.axe + "`  |  modes : " + params.modes,
            "",
            "## Sorties",
            "- ranking cross-seed : `" + str(input.ranking) + "`",
            "- baselines (degré-contrôlé) : `" + str(input.baselines) + "`",
            "- communautés (axe-libre) : `" + str(input.communities) + "`",
            "- ORA Reactome top : `" + str(input.reactome) + "`",
            "- ORA aging top : `" + str(input.aging) + "`",
            "",
        ]
        Path(output.summary).parent.mkdir(parents=True, exist_ok=True)
        Path(output.summary).write_text("\n".join(lines))
